<?xml version="1.0"?>
<body language="English">
	<row id="msg_0561_T22R0401_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">We’ve had more visiting scholars\nthis year than I can remember--\fquite a few from corporate labs,\nactually. Silph, others.\rA sign of the university’s growing\nprestige, I should think.</language>
	</row>
	<row id="msg_0561_T22R0401_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Once I’m done here I’m going\nstraight for the Azalea gym.\rA real badge! Bug types, they say.\nI just have to survive the forest\fafter.</language>
	</row>
	<row id="msg_0561_T22R0401_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Strawberry: Pijji!</language>
	</row>
</body>
