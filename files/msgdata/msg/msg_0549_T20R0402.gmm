	<row id="msg_0549_T20R0402_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon you’re\fwalking with?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\nOh!\rYou found a Shiny Leaf!\nLet me see!\rHa! You’ve collected...\r{STRVAR_1 50, 1, 0}!\rWay to go!\nKeep it up and collect {STRVAR_1 50, 2, 0} more!</language>
	</row>
	<row id="msg_0549_T20R0402_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon you’re\fwalking with?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\nOh!\rYou found a Shiny Leaf!\nLet me see!\rHa! You’ve collected...\r{STRVAR_1 50, 1, 0}!\rWay to go!\nKeep it up and collect {STRVAR_1 50, 2, 0} more!</language>
	</row>
	<row id="msg_0549_T20R0402_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon you’re\fwalking with?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\rHa! You have already collected five\fShiny Leaves!\rLet me turn them into a crown!\nAnd what’s more...\fI will give you this, too!\r</language>
	</row>
	<row id="msg_0549_T20R0402_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon you’re\fwalking with?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\rHa! You have already collected five\fShiny Leaves!\rLet me turn them into a crown!\nAnd what’s more...\fI will give you this, too!\r</language>
	</row>
	<row id="msg_0549_T20R0402_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Cherish your friendship with\nPokémon for years to come!</language>
	</row>
	<row id="msg_0549_T20R0402_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Cherish your friendship with\nPokémon for years to come!</language>
	</row>
	<row id="msg_0549_T20R0402_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\rOh, I get it.\nAre you here to check on the award\fwith {STRVAR_1 1, 1, 0}?\r</language>
	</row>
	<row id="msg_0549_T20R0402_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: Hi, {STRVAR_1 3, 0, 0}!\nHow is your Pokémon?\rYou can talk to it as you walk from time\nto time to nurture your friendship!\r...\rOh, I get it.\nAre you here to check on the award\fwith {STRVAR_1 1, 1, 0}?\r</language>
	</row>
	<row id="msg_0549_T20R0402_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">It’s a Wii!\rWii is huge in Johto, too!</language>
	</row>
	<row id="msg_0549_T20R0402_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You shouldn’t mess with someone\nelse’s PC!</language>
