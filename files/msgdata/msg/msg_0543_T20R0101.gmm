	<row id="msg_0543_T20R0101_00092" index="92">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Would you like to heal\nyour Pokémon? {YESNO 0}</language>
	</row>
	<row id="msg_0543_T20R0101_00093" index="93">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} opened a book.\rTravel Tip 1: Touch the A Button\nicon on the Touch Screen.\rYou can check things, talk to people,\nand so on.</language>
	</row>
	<row id="msg_0543_T20R0101_00094" index="94">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} opened a book.\rTravel Tip 2: The Trainer Card is the\nidentification card for you as a Trainer\fto travel with your Pokémon.\rRecord your adventure with SAVE!</language>
	</row>
	<row id="msg_0543_T20R0101_00095" index="95">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} opened a book.\rTravel Tip 3: Items in your Bag are\nsorted by their categories.</language>
	</row>
	<row id="msg_0543_T20R0101_00096" index="96">
		<attribute name="window_context_name">used</attribute>
		<language name="English">{STRVAR_1 3, 0, 0} opened a book.\rTravel Tip 4: The Pokégear is a\nuseful tool.\rYou can make a phone call,\nlisten to the radio, check the map,\fand so on.</language>
	</row>
	<row id="msg_0543_T20R0101_00097" index="97">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You found a memo...\nIf a Pokémon is trying to evolve,\fyou can stop it.\rPress the B Button during evolution.</language>
	</row>
	<row id="msg_0543_T20R0101_00098" index="98">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
