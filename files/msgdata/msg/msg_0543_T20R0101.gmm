	</row>
	<row id="msg_0543_T20R0101_00018" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh - a visitor!\rEveryone on this floor is running\nthree field studies at once.\rThe professor is at the back of\nthe room, if you’re looking for him.</language>
	</row>
