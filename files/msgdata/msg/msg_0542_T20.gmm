	<row id="msg_0542_T20_00005" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Oh! Your Pokémon is adorable!\nI wish I had one!</language>
	</row>
	<row id="msg_0542_T20_00006" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Half this town works for the\ninstitute these days.\rField teams in and out at all hours!</language>
	</row>
	<row id="msg_0542_T20_00007" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Half this town works for the\ninstitute these days.\rField teams in and out at all hours!</language>
	</row>
	<row id="msg_0542_T20_00008" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
	<row id="msg_0542_T20_00009" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">I like your Bag!</language>
	</row>
	<row id="msg_0542_T20_00010" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
	<row id="msg_0542_T20_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
	<row id="msg_0542_T20_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This used to be such a sleepy town.\rThen the institute grew, and now\nresearchers come from every region.</language>
	</row>
	<row id="msg_0542_T20_00013" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
	<row id="msg_0542_T20_00014" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
	<row id="msg_0542_T20_00015" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lyra: {STRVAR_1 3, 0, 0}!\rSo you picked...\n{STRVAR_1 0, 1, 0}!\rThat’s a cute Pokémon you have!\rWhen you walk with it, it’ll become\nmore friendly.\rYou should turn around and talk to it\nsometimes, too.\rOh, that’s right!\nWhy don’t you show it to your mom?\fSee ya!\r</language>
	</row>
	<row id="msg_0542_T20_00016" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Ethan: {STRVAR_1 3, 0, 0}!\rSo you picked...\n{STRVAR_1 0, 1, 0}!\rThat’s a cute Pokémon you have!\rWhen you walk with it, it’ll become\nmore friendly.\rYou should turn around and talk to it\nsometimes, too.\rOh, that’s right!\nWhy don’t you show it to your mom?\fSee ya!\r</language>
	</row>
	<row id="msg_0542_T20_00017" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">-</language>
	</row>
