	<row id="msg_0554_T21R0401_00011" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">GOLD: Hm? Oh - just talking things over\nwith Typhlosion.\rThese Cheri trees need more sun, and\nthe Pecha bush is looking thirsty...\rNow where did I put my old squirt\nbottle?\r</language>
	</row>
	<row id="msg_0554_T21R0401_00012" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">These are Gold’s Pokémon. Best not\nto touch them.\r</language>
	</row>
