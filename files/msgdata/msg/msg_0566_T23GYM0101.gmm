<?xml version="1.0"?>
<body language="English">
	<row id="msg_0566_T23GYM0101_00000" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Yo, challenger!\rAzalea’s gym runs on spinarak\nsilk--step on the web platforms to\fcross.\rBug types lean on status: poison,\nsleep, screens. Bring something\fthat hits hard before they bog you\ndown. Or bring patience.\rYou’ll need one or the other.\rOh--and the kid at the back? That’s\nTurk. Bugsy’s only WATCHING today.</language>
	</row>
	<row id="msg_0566_T23GYM0101_00001" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Well done! That was a great clash\nof talented young Trainers.\rWith people like you, the future of\nPokémon is bright!</language>
	</row>
	<row id="msg_0566_T23GYM0101_00002" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Azalea Town Pokémon Gym</language>
	</row>
	<row id="msg_0566_T23GYM0101_00003" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Azalea Town Pokémon Gym\rLeader-in-training: Turk\nOfficiating: Bugsy\f{STRVAR_1 3, 0, 0} - certified this day!</language>
	</row>
</body>
